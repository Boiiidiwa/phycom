// MOCK EXAM: รับข้อมูลจาก MQTT แล้วสั่งอุปกรณ์ตามข้อความที่ได้รับ
#include <WiFiS3.h>
#include <MQTTClient.h>

// ข้อมูล Wi-Fi ของบอร์ด
const char WIFI_SSID[] = "boiii";
const char WIFI_PASSWORD[] = "b123456789";
const char MQTT_BROKER_ADRRESS[] = "phycom.it.kmitl.ac.th";
const int MQTT_PORT = 1883;  // Arduino ใช้ MQTT/TCP; หน้าเว็บใช้ WSS 8884
const char MQTT_CLIENT_ID[] = "tan68070092";
const char SUBSCRIBE_TOPIC[] = "68070092/venus";

WiFiClient network;
MQTTClient mqtt = MQTTClient(256);

// RGB แบบ Common Anode: ขารวมต่อ 5V; LOW = ติด, HIGH = ดับ
const int RED_PIN = 3;
const int GREEN_PIN = 4;
const int BLUE_PIN = 5;

void setup() {
  Serial.begin(9600);
  pinMode(RED_PIN, OUTPUT);
  pinMode(GREEN_PIN, OUTPUT);
  pinMode(BLUE_PIN, OUTPUT);
  setColor(false, false, false);  // ดับทุกสีก่อนรับข้อมูลครั้งแรก

  // เชื่อม Wi-Fi ก่อน จึงจะติดต่อ Broker ได้
  while (WiFi.status() != WL_CONNECTED) {
    Serial.println("Connecting Wi-Fi...");
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    delay(10000);
  }
  Serial.print("IP: ");
  Serial.println(WiFi.localIP());

  // ลงทะเบียน callback ที่จะทำงานเมื่อมีข้อความเข้ามา
  mqtt.begin(MQTT_BROKER_ADRRESS, MQTT_PORT, network);
  mqtt.onMessage(messageReceived);
  connectToMQTT();
}

void loop() {
  // วนรับข้อความต่อเนื่อง ไม่ใส่ delay ยาวที่ขวางการประมวลผล MQTT
  mqtt.loop();
  if (!mqtt.connected()) {
    connectToMQTT();
  }
}

void connectToMQTT() {
  // Client ID ของแต่ละบอร์ดต้องไม่ซ้ำกัน
  Serial.print("Connecting MQTT");
  while (!mqtt.connect(MQTT_CLIENT_ID, "", "")) {
    Serial.print(".");
    delay(1000);
  }
  Serial.println(" connected");

  // ต้องสมัครรับอีกครั้งหลังเชื่อม Broker ใหม่
  if (mqtt.subscribe(SUBSCRIBE_TOPIC)) {
    Serial.print("Subscribed: ");
    Serial.println(SUBSCRIBE_TOPIC);
  } else {
    Serial.println("Subscribe failed");
  }
}

void messageReceived(String &topic, String &payload) {
  if (topic != SUBSCRIBE_TOPIC) return;
  payload.trim();  // ตัดช่องว่างและการขึ้นบรรทัดใหม่หัวท้าย
  Serial.print("Received: ");
  Serial.println(payload);

  // โจทย์ส่งอุณหภูมิเป็นจำนวนเต็ม; ไม่รับข้อความที่มีตัวอักษรปน
  if (payload.length() == 0) return;
  for (unsigned int i = 0; i < payload.length(); i++) {
    if (payload[i] < '0' || payload[i] > '9') return;
  }
  int temp = payload.toInt();

  // ตรวจช่วงอุณหภูมิตามโจทย์ และเปิดเพียงสีเดียว
  if (temp >= 36 && temp <= 50) {
    setColor(true, false, false);   // แดง: 36–50 °C
  } else if (temp >= 26 && temp <= 35) {
    setColor(false, false, true);   // ฟ้า/น้ำเงิน: 26–35 °C
  } else if (temp >= 10 && temp <= 25) {
    setColor(false, true, false);   // เขียว: 10–25 °C
  } else {
    setColor(false, false, false);  // นอกช่วงโจทย์ ให้ดับทุกสี
  }
}

// รับ true เมื่อต้องการเปิดสีนั้น แล้วแปลงเป็น LOW สำหรับ Common Anode
void setColor(bool red, bool green, bool blue) {
  digitalWrite(RED_PIN, red ? LOW : HIGH);
  digitalWrite(GREEN_PIN, green ? LOW : HIGH);
  digitalWrite(BLUE_PIN, blue ? LOW : HIGH);
}
